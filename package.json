{
  "name": "fondo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:quality": "qlty check --fail-level medium",
    "check:quality:all": "qlty check --all --fail-level medium",
    "security": "qlty check --all --level medium",
    "smells": "qlty smells --all",
    "metrics": "qlty metrics --max-depth=2"
  },
  "devDependencies": {
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
