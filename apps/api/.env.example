NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fondo:change-me-locally@localhost:5433/fondo
APP_DATABASE_URL=postgresql://fondo_app:change-me-locally@localhost:5433/fondo
WEB_ORIGIN=http://localhost:5173
# Multiple origins are comma-separated; each must be a scheme and host only.
LOG_LEVEL=info
API_READ_RATE_LIMIT=100
API_WRITE_RATE_LIMIT=10
BETTER_AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=fondo-local-files
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=300
S3_MAX_FILE_SIZE_BYTES=5242880
S3_AVATAR_MAX_FILE_SIZE_BYTES=2097152
