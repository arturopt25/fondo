generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum ServiceKey {
  PERSONAL_FINANCE
  VEHICLE
  HOME
  INSURANCE
  ENTREPRENEURSHIP
}

enum ServiceStatus {
  ACTIVE
  DISABLED
}

enum ServiceLedgerMode {
  SHARED
  SEPARATE
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  OTHER
}

enum LedgerScope {
  PERSONAL
  SEPARATE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id            String    @id
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  settings    UserSettings?
  ownedTenants Tenant[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @db.VarChar(255)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Tenant {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(120)
  slug              String   @unique @db.VarChar(80)
  accountingCurrency String  @default("USD") @db.Char(3)
  timeZone          String   @default("UTC") @db.VarChar(64)
  ownerUserId       String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner  User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members Membership[]
  subscriptions ServiceSubscription[]
  accounts FinancialAccount[]
  categories Category[]
  ledgers Ledger[]
  transactions Transaction[]

  @@index([accountingCurrency])
}

model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model UserSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique
  locale          String   @default("es") @db.VarChar(8)
  theme           String   @default("dark") @db.VarChar(16)
  displayCurrency String   @default("USD") @db.Char(3)
  timeZone        String   @default("UTC") @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceDefinition {
  id          String      @id @default(uuid()) @db.Uuid
  key         ServiceKey  @unique
  name        String      @db.VarChar(120)
  description String      @db.VarChar(255)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subscriptions ServiceSubscription[]
  capabilities  ServiceCapabilityDefinition[]
}

model ServiceCapabilityDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  serviceId      String   @db.Uuid
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(120)
  description    String   @db.VarChar(255)
  required       Boolean  @default(false)
  defaultEnabled Boolean  @default(false)
  dependsOn      String[] @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  selections ServiceCapabilitySelection[]

  @@unique([serviceId, key])
  @@index([serviceId])
}

model ServiceSubscription {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  serviceId  String           @db.Uuid
  status     ServiceStatus    @default(ACTIVE)
  ledgerMode ServiceLedgerMode @default(SHARED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service ServiceDefinition            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  selections ServiceCapabilitySelection[]

  @@unique([tenantId, serviceId])
  @@index([serviceId])
}

model ServiceCapabilitySelection {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  capabilityId   String   @db.Uuid
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription ServiceSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  capability  ServiceCapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, capabilityId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  actorId   String?
  action    String   @db.VarChar(64)
  resource  String   @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model Ledger {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  name       String      @db.VarChar(120)
  scope      LedgerScope @default(PERSONAL)
  businessId String?     @db.Uuid
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts     FinancialAccount[]
  transactions Transaction[]

  @@unique([tenantId, businessId])
  @@index([tenantId])
}

model FinancialAccount {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @db.Uuid
  ledgerId            String      @db.Uuid
  name                String      @db.VarChar(120)
  type                AccountType
  currency            String      @default("USD") @db.Char(3)
  openingBalanceMinor Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledger       Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  entries      TransactionEntry[]

  @@index([tenantId])
  @@unique([ledgerId, name])
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  name      String       @db.VarChar(120)
  type      CategoryType
  isDefault Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  entries      TransactionEntry[]

  @@index([tenantId])
  @@unique([tenantId, name, type])
}

model Transaction {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  ledgerId         String          @db.Uuid
  type             TransactionType
  amountMinor      Int
  categoryId       String?         @db.Uuid
  accountId        String?         @db.Uuid
  transferFromId   String?         @db.Uuid
  transferToId     String?         @db.Uuid
  serviceKey       ServiceKey?
  sourceType       String?         @db.VarChar(32)
  sourceId         String?         @db.Uuid
  note             String?         @db.VarChar(500)
  occurredAt       DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  reversesId       String?         @unique @db.Uuid
  reversedById     String?         @unique @db.Uuid
  idempotencyKey   String?         @db.VarChar(128)
  idempotencyHash  String?         @db.VarChar(64)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledger   Ledger           @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  entries  TransactionEntry[]
  reverses Transaction?      @relation("TransactionReversal")
  reversedBy Transaction?    @relation("TransactionReversal", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([ledgerId, occurredAt])
  @@index([accountId])
  @@index([serviceKey])
  @@unique([tenantId, idempotencyKey])
}

model TransactionEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  transactionId      String         @db.Uuid
  financialAccountId String?        @db.Uuid
  categoryId         String?        @db.Uuid
  direction          EntryDirection
  amountMinor        Int
  createdAt          DateTime       @default(now())

  transaction Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([financialAccountId, direction])
  @@index([categoryId])
}