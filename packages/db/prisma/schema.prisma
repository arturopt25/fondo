generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum ServiceKey {
  PERSONAL_FINANCE
  VEHICLE
  HOME
  INSURANCE
  ENTREPRENEURSHIP
}

enum ServiceStatus {
  ACTIVE
  DISABLED
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id            String    @id
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  settings    UserSettings?
  ownedTenants Tenant[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @db.VarChar(255)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Tenant {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(120)
  slug              String   @unique @db.VarChar(80)
  accountingCurrency String  @default("USD") @db.Char(3)
  timeZone          String   @default("UTC") @db.VarChar(64)
  ownerUserId       String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner  User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members Membership[]
  subscriptions ServiceSubscription[]
  accounts FinancialAccount[]
  categories Category[]

  @@index([accountingCurrency])
}

model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model UserSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique
  locale          String   @default("es") @db.VarChar(8)
  theme           String   @default("dark") @db.VarChar(16)
  displayCurrency String   @default("USD") @db.Char(3)
  timeZone        String   @default("UTC") @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceDefinition {
  id          String      @id @default(uuid()) @db.Uuid
  key         ServiceKey  @unique
  name        String      @db.VarChar(120)
  description String      @db.VarChar(255)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subscriptions ServiceSubscription[]
}

model ServiceSubscription {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  serviceId String        @db.Uuid
  status    ServiceStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceId])
  @@index([serviceId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  actorId   String?
  action    String   @db.VarChar(64)
  resource  String   @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model FinancialAccount {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @db.Uuid
  name                String      @db.VarChar(120)
  type                AccountType
  currency            String      @default("USD") @db.Char(3)
  openingBalanceMinor Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  name      String       @db.VarChar(120)
  type      CategoryType
  isDefault Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, name, type])
}