POSTGRES_DB=fondo
POSTGRES_USER=fondo
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://fondo:change-me-locally@localhost:5433/fondo
APP_DATABASE_URL=postgresql://fondo_app:change-me-locally@localhost:5433/fondo
WEB_ORIGIN=http://localhost:5173
# Multiple origins are comma-separated; each must be a scheme and host only.
LOG_LEVEL=info
API_READ_RATE_LIMIT=100
API_WRITE_RATE_LIMIT=10
# Optional: comma-separated CIDRs of trusted reverse proxies (e.g. Cloudflare).
# TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22
# Readiness probe timeout; keep it below Render's 5s HTTP health check timeout.
# HEALTH_DB_TIMEOUT_MS=2500
